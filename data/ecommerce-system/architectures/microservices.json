{
  "components": [
    {
      "name": "Frontend",
      "type": "Application",
      "responsibilities": [
        "User Interaction",
        "Client",
        "Business Process"
      ],
      "technologies": [
        "react.js"
      ],
      "interactsWith": [
        "API Gateway"
      ]
    },
    {
      "name": "API Gateway",
      "type": "Microservice",
      "responsibilities": [
        "Token Authentication and Authorization",
        "API Routing"
      ],
      "technologies": [
        "Node.js"
      ],
      "interactsWith": [
        "Frontend",
        "User Service",
        "Product Service",
        "Order Service"
      ]
    },
    {
      "name": "User Service",
      "type": "Microservice",
      "responsibilities": [
        "Credential Authentication",
        "Authorization",
        "Profile Management"
      ],
      "technologies": [
        "Node.js",
        "PostgreSQL"
      ],
      "interactsWith": [
        "API Gateway",
        "Order Service"
      ]
    },
    {
      "name": "Product Service",
      "type": "Microservice",
      "responsibilities": [
        "Managing the Product Catalog",
        "Browsing and Searching",
        "Inventory Updates"
      ],
      "technologies": [
        "Node.js",
        "MongoDB"
      ],
      "interactsWith": [
        "API Gateway",
        "Order Service",
        "Inventory Service"
      ]
    },
    {
      "name": "Order Service",
      "type": "Microservice",
      "responsibilities": [
        "Shopping Cart Operations",
        "Order Placement",
        "Tracking"
      ],
      "technologies": [
        "Node.js",
        "PostgreSQL"
      ],
      "interactsWith": [
        "API Gateway",
        "User Service",
        "Product Service",
        "Payment Service",
        "Inventory Service"
      ]
    },
    {
      "name": "Payment Service",
      "type": "Microservice",
      "responsibilities": [
        "Payment processing, including integration with third-party gateways"
      ],
      "technologies": [
        "Node.js",
        "MongoDB"
      ],
      "interactsWith": [
        "Order Service",
        "External Payment Provider"
      ]
    },
    {
      "name": "Inventory Service",
      "type": "Microservice",
      "responsibilities": [
        "Track Stock Levels",
        "Update stock from order events",
        "Notify low stock",
        "Provide stock APIs"
      ],
      "technologies": [
        "Node.js",
        "PostgreSQL"
      ],
      "interactsWith": [
        "Product Service",
        "Order Service",
        "External Inventory System"
      ]
    }
  ],
  "infrastructure": [
    {
      "environment": [
        "Virtual Server"
      ],
      "components": [
        "Frontend"
      ]
    },
    {
      "environment": [
        "API Gateway"
      ],
      "components": [
        "Frontend"
      ]
    },
    {
      "environment": [
        "Kubernetes Cluster",
        "Apache Kafka"
      ],
      "components": [
        "User Service",
        "Product Service",
        "Order Service",
        "Payment Service",
        "Inventory Service"
      ]
    }
  ]
}